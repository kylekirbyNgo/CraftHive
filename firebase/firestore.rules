rules_version = '2';

// CraftHive – Firestore security rules.
// request.auth.uid is the user's Supabase user ID: the app signs in to
// Firebase with a custom token from the firebase-bridge Edge Function.
// The Edge Function writes with a service account, which skips these rules,
// so notifications, quote cards and order updates can only come from it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function chat(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function inChat(chatId) {
      return signedIn() && request.auth.uid in chat(chatId).participantUids;
    }

    // chats/{buyerUid}_{storeId} – one chat per buyer and store
    match /chats/{chatId} {
      // A missing chat may be checked, so the app knows whether to create it.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participantUids);
      // Listing needs: where('participantUids', arrayContains: myUid)
      allow list: if signedIn() && request.auth.uid in resource.data.participantUids;

      allow create: if signedIn()
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.buyerUid in request.resource.data.participantUids
        && request.resource.data.sellerUid in request.resource.data.participantUids
        && request.resource.data.buyerUid != request.resource.data.sellerUid
        && chatId == request.resource.data.buyerUid + '_' + request.resource.data.storeId;

      // People in the chat may only change the last message, unread counts,
      // read times and the product being discussed.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderUid', 'unread', 'lastReadAt', 'productId']);

      match /messages/{messageId} {
        allow read: if inChat(chatId);
        // The app sends text and photo messages; quote cards and system notes come from the server.
        // A photo must be stored in this chat's folder of the chat-photos bucket.
        allow create: if inChat(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.type == 'text' && request.resource.data.text.size() > 0)
            || (request.resource.data.type == 'photo'
                && request.resource.data.imagePath is string
                && request.resource.data.imagePath.matches('^' + chatId + '/[A-Za-z0-9_.-]+$'))
          );
      }
    }

    // notifications/{uid}/items/{id} – written by the server only
    match /notifications/{uid}/items/{id} {
      allow read, delete: if isMe(uid);
      allow update: if isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // users/{uid} – push tokens (fcmTokens); recentSearches and savedItems below it
    match /users/{uid} {
      allow read, write: if isMe(uid);
      match /{document=**} {
        allow read, write: if isMe(uid);
      }
    }

    // productStats/{productId} – how many people saved a product.
    // The count may go up by one only in the same write that saves the item
    // (users/{uid}/savedItems/{productId}), and down by one only when it is removed.
    function savedBefore(productId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/savedItems/$(productId));
    }
    function savedAfter(productId) {
      return existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/savedItems/$(productId));
    }

    match /productStats/{productId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['saveCount'])
        && request.resource.data.saveCount == 1
        && !savedBefore(productId) && savedAfter(productId);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saveCount'])
        && (
          (request.resource.data.saveCount == resource.data.get('saveCount', 0) + 1 && !savedBefore(productId) && savedAfter(productId))
          || (request.resource.data.saveCount == resource.data.get('saveCount', 0) - 1 && savedBefore(productId) && !savedAfter(productId))
        )
        && request.resource.data.saveCount >= 0;
    }
  }
}
